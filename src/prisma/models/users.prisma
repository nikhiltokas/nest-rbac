// use prisma-8

/// Coarse-grained authorization role. Extend per product
enum UserRole {
    SUPER_ADMIN
    MODERATOR
    USER
}

/// User — the canonical identity record.
model User {
    id   Uuid   @id @default(uuid(7))
    role UserRole @default(USER)

    firstName     VarChar(50)
    lastName      VarChar(50)?
    username      String  @unique
    email         String  @unique
    passwordHash  String

    // Audit.
    createdBy String?
    updatedBy String?
    createdAt temporal.createdAt()
    updatedAt temporal.updatedAt()

    // Relationships
    comments Comment[]
    notes    Note[]
}
